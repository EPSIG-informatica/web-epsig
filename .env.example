# Envío del formulario de contacto. Copia este archivo como .env.local (en local y en el servidor).
# Comprueba la configuración con: npm run test-correo

# Buzón que envía (aviso a CONTACT_TO y confirmación al cliente) y buzón que recibe las solicitudes.
CONTACT_FROM=info@epsigconsultores.com
CONTACT_TO=info@epsigconsultores.com

# Opción recomendada: Microsoft Graph (aplicación registrada en Entra ID con el permiso de
# aplicación Mail.Send y consentimiento de administrador). Si GRAPH_TENANT_ID tiene valor,
# se usa Graph y se ignoran las variables SMTP_*.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# Credencial: certificado (.pem con clave privada + certificado, junto a package.json; su .cer
# se sube a la aplicación en Entra) o, si el inquilino permite secretos, GRAPH_CLIENT_SECRET.
GRAPH_CERT_FILE=graph-cert.pem
GRAPH_CLIENT_SECRET=

# Alternativa: SMTP con usuario y contraseña (Microsoft 365 puede tenerlo desactivado).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@epsigconsultores.com
SMTP_PASS=

# Alternativa sin contraseña (Microsoft 365 "Direct Send"): deja SMTP_USER/SMTP_PASS
# vacíos, usa SMTP_HOST=epsigconsultores-com.mail.protection.outlook.com y SMTP_PORT=25.
# Requiere salida por el puerto 25 y la IP del servidor en el SPF del dominio.

# CRM de Odoo: cada envío del formulario crea una oportunidad (etiqueta "Web", con fuente,
# medio y campaña de la visita). Requiere plan Custom. Clave de API: en Odoo, Mi perfil →
# Seguridad de la cuenta → Nueva clave de API. Comprueba con: npm run test-odoo
ODOO_URL=https://epsig-consultores.odoo.com
ODOO_API_KEY=
# Solo para Odoo anterior a la 19 (API JSON-RPC): base de datos y usuario de la clave.
ODOO_DB=
ODOO_USER=
# Opcional: id del equipo de ventas al que asignar las oportunidades y nombre de la etiqueta.
ODOO_TEAM_ID=
ODOO_LEAD_TAG=Web

# Google Analytics 4 (ID de medición G-XXXXXXXXXX). Solo se carga si el usuario acepta
# las cookies analíticas en el banner. Vacío = sin Analytics.
NEXT_PUBLIC_GA_ID=
# Consent Mode v2: vacío = básico (GA solo tras aceptar las cookies analíticas).
# "advanced" = GA se carga siempre, sin cookies hasta aceptar (revisa antes la política de cookies).
NEXT_PUBLIC_GA_CONSENT_MODE=
# Google Search Console: el valor "content" de la meta etiqueta google-site-verification.
# (Alternativa: verificar por DNS en Cloudflare y dejar esto vacío.)
GOOGLE_SITE_VERIFICATION=
